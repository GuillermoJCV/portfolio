---
import { DiReact, DiJavascript, DiHtml5, DiCss3 } from "react-icons/di";
import { SiNestjs, SiTypescript } from "react-icons/si";
import { FaDatabase, FaCloudflare } from "react-icons/fa6";
import { MdDataObject } from "react-icons/md";
---

<section class="bento-cell">
	<h2>Skills</h2>
	<ul>
		<li>
			<DiHtml5/>
			<h6>HTML</h6>
		</li>
		<li>
			<DiCss3 />
			<h6>CSS</h6>
		</li>
		<li>
			<DiJavascript />
			<h6>Javascript</h6>
		</li>
		<li>
			<DiReact/>
			<h6>React</h6>
		</li>
		<li>
			<SiTypescript />
			<h6>Typescript</h6>
		</li>
		<li>
			<SiNestjs />
			<h6>Nest</h6>
		</li>
		<li>
			<FaDatabase />
			<h6>ORM's</h6>
		</li>
		<li>
			<FaCloudflare />
			<h6>Cloudflare</h6>
		</li>
		<li>
			<MdDataObject />
			<h6>POO</h6>
		</li>
	</ul>
</section>

<!-- Tenemos una variable --main-color -->

<style>
	section {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		max-height: calc(50vh - var(--space-between));
		overflow: auto;
	}
	h2 {
		text-align: center;
		font-family: Kode Mono;
	}

	ul {
		display: grid;
		margin-block: auto;
		grid-template-columns: repeat(auto-fill, minmax(5rem, 6rem));
		justify-content: center;
		justify-items: center;
		gap: clamp(0.5rem, 1vw, 2rem);
		list-style: none;
	}
	li {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-block: 1rem;
		width: clamp(5rem, 10vw, 5rem);
		text-align: center;
		border-radius: 1rem;
		color: var(--color-three);
		background: var(--contrast-gradient);
		filter: brightness(1);
		transition: filter 200ms;
	}
	li:hover {
		filter: brightness(1.5);
	}
	li svg {
		font-size: clamp(1rem, 5vw, 2rem);
		font-weight: 900;
		color: #010101;
	}
	h6 {
		color: #010101;
		letter-spacing: 1px;
		font-family: Kode Mono;
	}

</style>