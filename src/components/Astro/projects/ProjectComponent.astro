---
interface Props {
	title		: string;
	imgUrl		: string;
	webUrl		: string;
}

import { Image } from "astro:assets"

const { title, imgUrl, webUrl } = Astro.props;
---

<div>
	<a href={webUrl} target="__blank">
		<figure>
			<img 	src={imgUrl} 
					alt={title}
					decoding="async"
  					loading="lazy"/>
		</figure>
	</a>
	<section>
		<slot name="description"/>
		<slot name="skills">
	</section>
</div>

<style>
	div {
		display: flex;
		flex-direction: var(--flex-direction);
		justify-content: var(--justify-div);
		gap: 1rem;
		background: var(--text-gradient-1),
    				var(--text-gradient-2),
    				var(--text-gradient-3);
		border-radius: 1rem;
		min-height: 20rem;
		overflow: hidden;
		width: 100%;
	}
	a {
		width: var(--figure-width);
	}
	figure {
		overflow: hidden;
		height: 100%;
	}
	img {
		border-radius: 1rem;
		width: var(--figure-width);
		height: 20rem;
		aspect-ratio: 1112/775;
		scale: 1;
		transition: scale 500ms;
	}
	img:hover {
		scale: 1.3;
	}

	section {
		padding: 1rem;
		display: var(--section-display);
		flex-direction: column;
		overflow-y: auto;
		overflow-x: hidden;
	}

	@media (max-width: 639px) {
		:root {
			--justify-div: center;
			--section-display: none;
			--flex-direction : row;
			--figure-width : 100%
		}
	}
	@media (min-width: 640px) {
		:root {
			--justify-div: center;
			--section-display: none;
			--flex-direction : column;
			--figure-width : 100%
		}
	}
	@media (min-width: 768px) {
		:root {
			--justify-div: flex-start;
			--section-display: flex;
			--flex-direction : column;
			--figure-width : 100%
		}
	}
	@media (min-width: 1024px) {
		:root {
			--justify-div: flex-start;
			--section-display: flex;
			--flex-direction : column;
			--figure-width : 100%
		}
	}

	@media (min-width: 1280px) {
		:root {
			--justify-div: flex-start;
			--section-display: flex;
			--flex-direction : row;
			--figure-width : auto
		}
	}

</style>